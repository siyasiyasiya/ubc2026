{
  "name": "@ubc2026/agent",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/spike.ts",
    "spike": "tsx --env-file=.env src/spike.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "tsx --test src/**/*.test.ts",
    "start": "tsx --env-file=.env src/app/imessage.ts",
    "sim": "tsx --env-file-if-exists=.env src/app/sim.ts"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@spectrum-ts/imessage-local": "^12.16.0",
    "spectrum-ts": "^12.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
