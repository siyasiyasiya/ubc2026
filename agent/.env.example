# "local" = run through Messages.app on this Mac (free, supports group chats)
# "cloud" = Photon Stable cloud line (needs the two SPECTRUM_ values below)
IMESSAGE_MODE=local

# Local mode only replies in these chats (comma-separated space ids, printed by the bot)
ALLOWED_SPACE_IDS=

# Photon Stable (Spectrum) credentials: only for IMESSAGE_MODE=cloud
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
