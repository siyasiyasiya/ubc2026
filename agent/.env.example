# Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional: CLAUDE_MODEL (default claude-opus-5-5), AGENT_EFFORT (default low)

# "local" = run through Messages.app on this Mac (free, supports group chats)
# "cloud" = Photon Stable cloud line (needs the two SPECTRUM_ values below)
IMESSAGE_MODE=local

# The bot only acts in these chats (comma-separated space ids; npm run spike prints them)
ALLOWED_SPACE_IDS=

# Display names for members: +18475551234=Tristan,+16105551234=Siya
MEMBER_NAMES=
# Weekly limit new members start with, in USD
DEFAULT_WEEKLY_LIMIT_USD=200

# Photon Stable (Spectrum) credentials: only for IMESSAGE_MODE=cloud
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
