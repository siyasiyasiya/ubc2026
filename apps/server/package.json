{
  "name": "@gta/server",
  "version": "0.0.0",
  "description": "Composition root: wires adapters into the core state machine and runs the agent process.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "sim": "tsx --env-file-if-exists=.env src/sim.ts",
    "test": "vitest run --passWithNoTests",
    "invite": "tsx --env-file-if-exists=.env src/invite.ts",
    "fund": "tsx --env-file-if-exists=.env src/fund.ts",
    "crossmint": "tsx --env-file-if-exists=.env src/crossmint.ts",
    "diag": "tsx --env-file-if-exists=.env src/diag.ts",
    "vibe": "tsx --env-file-if-exists=.env src/vibe.ts",
    "smoke-arc": "tsx --env-file-if-exists=.env src/smoke-arc.ts"
  },
  "dependencies": {
    "@gta/agent": "workspace:*",
    "@gta/core": "workspace:*",
    "@gta/funding": "workspace:*",
    "@gta/imessage": "workspace:*",
    "@gta/purchase": "workspace:*",
    "@gta/wallet": "workspace:*",
    "@photon-ai/imessage-kit": "3.0.0",
    "@resvg/resvg-js": "2.6.2",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
