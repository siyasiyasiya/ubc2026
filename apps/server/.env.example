# The `sim` demo (pnpm --filter @gta/server sim) needs ONLY ANTHROPIC_API_KEY below.
# Everything under "live iMessage" is for `dev` (real Messages.app) and is ignored by the sim.

# Claude API key (console.anthropic.com -> API keys). A Claude Pro/Max subscription does NOT work.
ANTHROPIC_API_KEY=
# Optional: CLAUDE_MODEL (default claude-sonnet-5), AGENT_EFFORT (default low)
# Optional: DEFAULT_LIMIT_USD (default 200) — set low (e.g. 20) to demo an over-limit "Partly settled"

# ---- live iMessage only (pnpm --filter @gta/server dev) ----

# "local" = run through Messages.app on this Mac (free, supports group chats; needs Full Disk
# Access for the terminal). "cloud" = Photon Stable cloud line (needs SPECTRUM_ values below).
IMESSAGE_MODE=local

# Leave EMPTY (recommended, bot on its own Apple ID): the bot auto-serves every group chat it's in
# and auto-seeds members from each chat's roster. Set a comma-separated list to restrict it to
# specific chats instead (send #treasury in a chat to log its id).
ALLOWED_CHAT_IDS=

# Leave EMPTY when the bot has its own Apple ID (the recommended setup). Only set this to a member's
# handle if the bot runs on that member's Apple ID, so their own messages/👍s count as theirs.
SELF_HANDLE=

# Optional display-name overrides: +18475551234=Tristan,+16105551234=Siya. Members are auto-discovered
# from the chat roster, so this is only needed to prettify names the roster shows as a raw handle.
MEMBER_NAMES=
# Limit new members start with
DEFAULT_LIMIT_USD=200
DEFAULT_LIMIT_PERIOD=weekly

# Photon Stable (Spectrum) credentials: only for IMESSAGE_MODE=cloud
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# --- Arc (GroupTreasury) ---
# Set TREASURY_ADDRESS and OPERATOR_PRIVATE_KEY to pull shares onchain; leave empty for the in-memory wallet.
ARC_RPC_URL=https://rpc.testnet.arc.network
TREASURY_ADDRESS=0x1E383fe0098f3dE2530b42f1c8172CA2BC547320
# The agent's operator key (same as contracts/.env). Proposes splits, relays 👍, can only lower limits.
OPERATOR_PRIVATE_KEY=
# Kitty account per member until the Face ID join watcher fills these in: +18475551234=0xabc…
MEMBER_WALLETS=
# Block the treasury was deployed at, where the Face ID join watcher starts the first time
TREASURY_DEPLOY_BLOCK=72966618

# --- Face ID invites ---
# Tickets in invite links are derived from this. Any long random string; keep it stable and secret.
INVITE_SECRET=
# The Face ID page
ONBOARD_URL=https://kittyagent.vercel.app
# Testnet only: dollars the operator sends each new member (0 to turn off)
WELCOME_USD=5

# Kitty buys things for the group (pay before). With these set, orders are real (Crossmint Agent
# Checkouts, production keys, paid by a saved card). Without them, a simulated store is used and
# it says "(simulated)" wherever it shows.
# Server key (agent-checkouts.* scopes)
CROSSMINT_API_KEY=
# Client key (payment-methods.* + order-intents.* scopes): card authorizations refuse server keys
CROSSMINT_CLIENT_API_KEY=
# Any stable id for the card's owner, e.g. kitty-neena (the JWT's sub)
CROSSMINT_USER_ID=
# From the save-card page: pnpm --filter @gta/server crossmint-card
CROSSMINT_PAYMENT_METHOD_ID=
# Kitty signs Crossmint user JWTs ("Custom tokens" in the console). PKCS#8 PEM with \n escapes;
# its public half is apps/onboard/public/.well-known/jwks.json, served at <ONBOARD_URL>/api/jwks
CROSSMINT_JWT_PRIVATE_KEY=
CROSSMINT_JWT_KID=kitty-2

# Kitty phones restaurants with an ElevenLabs voice agent (see docs/elevenlabs-agent.md).
# The phone number is a Twilio number connected in ElevenLabs; its id is the phone_number_id.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Testnet only: members text Kitty "add $20" and get test dollars from the operator's wallet.
# TESTNET_TOPUP=off disables it. Top up the operator at faucet.circle.com (Arc Testnet).
TESTNET_TOPUP_MAX_USD=20
TESTNET_TOPUP_DAILY_USD=50
