# Circle Console -> Keys -> Client Key (domain must match where this page is served)
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# GroupTreasury on Arc testnet (contracts/README.md)
VITE_TREASURY_ADDRESS=0xAF2b75eda3c50358Ce754b93c60F76F0871bE235
# Optional: Blockscout API key (dev.blockscout.com) for the dashboard's history proxy (api/explorer.ts).
# Without it the Arc explorer's anonymous per-IP limit applies; the proxy's edge cache keeps calls low.
ARCSCAN_API_KEY=
# QuickNode Streams (README "Real-time onchain data"). Set these in Vercel.
# Neon Postgres from the Vercel Marketplace; the Stream's webhook (api/stream.ts) writes here.
DATABASE_URL=
# The Stream's security token (32+ chars); api/stream.ts rejects deliveries not signed with it.
QN_STREAM_SECRET=
# Bearer token Kitty's bot sends to api/events.ts (same value as the server's EVENTS_SECRET).
EVENTS_SECRET=
