{
  "name": "group-treasury-agent",
  "private": true,
  "version": "0.0.0",
  "description": "An agent in your iMessage group chat that handles shared spending for friends, trips and roommates.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:contracts": "cd contracts && forge test",
    "dev": "pnpm --filter @gta/server run dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
